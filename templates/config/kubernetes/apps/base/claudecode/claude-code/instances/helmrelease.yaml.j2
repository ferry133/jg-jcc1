# claude-code EXTRA instances only, since 2026-09-06: the default `im`
# HelmRelease is static and lives in jg-base
# (kubernetes/apps/base/claudecode/claude-code/im/), switched on by the
# claude-code-im patch in flux/cluster/ks.yaml.j2. Declaring "im" here is a
# render error (plugin.py) -- it would fight the base object over its name.
# Use claude_instances for renamed/additional terminals (jg-jiahd's "cc") and
# for the basic-auth instance a claudecode_auth0:false cluster needs. The
# shared manifests (namespace, SA/RBAC, OCIRepository, secrets) come from
# jg-base kubernetes/apps/base/claudecode.
#% for instance in claude_instances %#
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: #{instance}#
  namespace: claudecode
spec:
  chartRef:
    kind: OCIRepository
    name: claude-code
  interval: 1h
  # With replicas at 0 no pod ever schedules, and a WaitForFirstConsumer storage
  # class binds a PVC only when one does — so Helm waiting for these claims to
  # bind would time out and fail the release permanently. Immediate binding
  # (what an NFS class does) hides this; local-path exposes it. Harmless when
  # the instance is always on, so it is not made conditional.
  install:
    disableWait: true
  upgrade:
    disableWait: true
  values:
    controllers:
      #{instance}#:
#% if talos_mcp_config is defined %#
        # The talos-mcp sidecar below holds the Omni SA key in talos-mcp-secret;
        # this is when that key expires, for jg-base's daily-check row 24
        # (ferry133/fleet-ops#11) -- the same annotation jg-base puts on the
        # base im. On the controller, not the pod: a new date restarts nothing.
        annotations:
          jg-base.jiahd.cc/omni-sa-key-expires: "${TALOS_MCP_SA_KEY_EXPIRES:-}"
#% endif %#
        strategy: Recreate
        # A LAN-facing root shell with network-scanning capability and
        # cluster-admin RBAC (see rbac.yaml in the jg-base claudecode app), so
        # it is off unless the cluster asks for it: scale to 1 only while
        # actively supporting this client.
        #
        # Declared rather than scaled by hand. A `kubectl scale` survives until
        # the next reconcile and then vanishes, which reads as an outage with no
        # cause — jgt-omni lost its terminal exactly that way on 2026-08-12, and
        # jg-jiahd carries a hand-edited copy of this file for the same reason.
        replicas: #{ 1 if instance in claude_code_always_on else 0 }#
        serviceAccount:
          name: claude-code # shared SA, RBAC bound in jg-base claudecode app
        containers:
          app:
            image:
              repository: ghcr.io/ferry133/claude-code
              tag: 9418571
            env:
              # The pod runs as uid 0 (see defaultPodOptions), which would
              # resolve HOME=/root -- but all state (claude config PVC,
              # keyring, workspace) lives under /home/claude.
              HOME: /home/claude
              # Without this, onboarding/account state goes to ~/.claude.json
              # in the ephemeral overlay and login is lost on every pod
              # restart; inside CLAUDE_CONFIG_DIR it lands on the PVC.
              CLAUDE_CONFIG_DIR: /home/claude/.claude
              # tmux asks the locale whether an attaching client can take
              # UTF-8; with LANG unset it decides no and rewrites every
              # non-ASCII cell as "_" on the way to the browser, which is how
              # Traditional Chinese reached cc.jiahd.cc as rows of underscores
              # (2026-08-11). Fixed at the image level too (LANG + `tmux -u`),
              # but set here as well so it holds on any tag predating that and
              # regardless of what the image ships.
              LANG: C.UTF-8
              # Registers the MCP memory server (explicit memory): k8scc's
              # claude-session runs `claude mcp add memory` only when this is
              # non-empty. Unconditional on purpose — the Secret key always
              # exists (jg-base secret.yaml defaults it to ""), an empty value
              # is exactly the no-database behavior, and a template conditional
              # here would add one more place where "forgot to set" and "chose
              # not to set" render identically (ferry133/jg-cluster-template#77:
              # this env was simply missing, and explicit memory was
              # zero-functional fleet-wide while the database it writes to was
              # deployed, backed up, and empty).
              DATABASE_URL:
                valueFrom:
                  secretKeyRef:
                    name: claude-code-secret
                    key: DATABASE_URL
#% if talos_mcp_config is defined %#
              # Registers the talos-mcp sidecar as a remote MCP server (see
              # claude-session in k8scc) -- reachable only via loopback since
              # this pod is hostNetwork.
              TALOS_MCP_URL: http://127.0.0.1:8765/sse
#% endif %#
#% if claudecode_auth0_enabled %#
              # OIDC mode (the default): the oauth2-proxy sidecar is the only
              # way in -- ttyd binds loopback and requires the email header the
              # proxy injects (value surfaces as TTYD_USER -> CLAUDE_USER_ID).
              # Explicit IP, not "lo": ttyd resolves an interface name to its
              # first non-127 address (Talos puts 169.254.x.x on lo).
              TTYD_INTERFACE: 127.0.0.1
              TTYD_AUTH_HEADER: X-Forwarded-Email
#% else %#
              # Only reached via `claudecode_auth0: false`. One shared password
              # in front of a cluster-admin root shell -- see the note on
              # claudecode_auth0_enabled in plugin.py for what that gives up.
              TTYD_CREDENTIAL:
                valueFrom:
                  secretKeyRef:
                    name: claude-code-secret
                    key: TTYD_CREDENTIAL
#% endif %#
            probes:
#% if claudecode_auth0_enabled %#
              # ttyd binds loopback, unreachable from kubelet's tcpSocket
              # probe (hostNetwork pod IP) -- check from inside the pod.
              liveness:
                enabled: true
                custom: true
                spec:
                  exec:
                    command: ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/7681"]
                  initialDelaySeconds: 15
                  periodSeconds: 30
                  timeoutSeconds: 5
                  failureThreshold: 3
              readiness:
                enabled: true
                custom: true
                spec:
                  exec:
                    command: ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/7681"]
                  initialDelaySeconds: 15
                  periodSeconds: 30
                  timeoutSeconds: 5
                  failureThreshold: 3
#% else %#
              liveness:
                enabled: true
                custom: true
                spec:
                  tcpSocket:
                    port: 7681
                  initialDelaySeconds: 15
                  periodSeconds: 30
                  timeoutSeconds: 5
                  failureThreshold: 3
              readiness:
                enabled: true
                custom: true
                spec:
                  tcpSocket:
                    port: 7681
                  initialDelaySeconds: 15
                  periodSeconds: 30
                  timeoutSeconds: 5
                  failureThreshold: 3
#% endif %#
            resources:
              requests:
                cpu: 100m
                memory: 256Mi
              limits:
                memory: 1Gi
#% if talos_mcp_config is defined %#
          talos-mcp:
            # Own container, own credential mount -- the app container above
            # never sees this secret. See openspec/changes/insideman in
            # jg-base for the full design.
            image:
              repository: ghcr.io/ferry133/claude-code
              tag: 9418571
            command: ["python3", "/usr/local/bin/talos_mcp_server.py"]
            env:
              TALOSCONFIG: /etc/talos-mcp/talosconfig
              # The talosconfig above carries no key material (Omni's siderov1
              # auth needs either a locally-registered PGP key -- which a
              # fresh container never has -- or these two env vars, read
              # directly by talosctl's own auth library). Endpoint must be a
              # direct, non-Cloudflare-Tunnel gRPC path (see talos-mcp-secret
              # in jg-base) -- confirmed 2026-07-30 against jg-jiahd that the
              # Tunnel breaks gRPC trailers the siderov1 proxy depends on.
              OMNI_SERVICE_ACCOUNT_KEY:
                valueFrom:
                  secretKeyRef:
                    name: talos-mcp-secret
                    key: saKey
              OMNI_ENDPOINT:
                valueFrom:
                  secretKeyRef:
                    name: talos-mcp-secret
                    key: omniEndpoint
            securityContext:
              allowPrivilegeEscalation: false
              capabilities: { drop: ["ALL"] }
            probes:
              # FastMCP binds 127.0.0.1 only (see talos_mcp_server.py); on a
              # hostNetwork pod, kubelet's tcpSocket probe dials the pod/node
              # IP, not loopback -- same class of bug as ttyd's OIDC-mode
              # probes above. exec + /dev/tcp/127.0.0.1 checks from inside.
              liveness:
                enabled: true
                custom: true
                spec:
                  exec:
                    command: ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8765"]
                  initialDelaySeconds: 10
                  periodSeconds: 30
                  timeoutSeconds: 5
                  failureThreshold: 3
              readiness:
                enabled: true
                custom: true
                spec:
                  exec:
                    command: ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8765"]
                  initialDelaySeconds: 10
                  periodSeconds: 30
                  timeoutSeconds: 5
                  failureThreshold: 3
            resources:
              requests:
                cpu: 10m
                memory: 32Mi
              limits:
                memory: 128Mi
#% endif %#
#% if claudecode_auth0_enabled %#
          oauth2-proxy:
            image:
              repository: quay.io/oauth2-proxy/oauth2-proxy
              tag: v7.15.3
            args:
              - --http-address=0.0.0.0:4180
              - --upstream=http://127.0.0.1:7681
              - --provider=oidc
              - --oidc-issuer-url=https://#{ claudecode_auth0_domain }#/
              - --scope=openid profile email
              - --redirect-url=https://#{instance}#.${SECRET_DOMAIN}/oauth2/callback
              - --authenticated-emails-file=/etc/oauth2-proxy/allowed-emails
              - --skip-provider-button=true
              # Off, deliberately, and not just left at the default -- someone
              # will want to add it back. See #9.
              #
              # What --reverse-proxy=true does in v7.15.3, read from the source
              # rather than from the flag's name:
              #
              #   - X-Forwarded-Proto/-Host/-Uri become trusted input. With no
              #     --trusted-proxy-ip they are trusted from 0.0.0.0/0 + ::/0
              #     (oauthproxy.go:404 logs a WARNING saying exactly that).
              #   - the `client` field in every request log stops being the
              #     connected peer and becomes whatever --real-client-ip-header
              #     names -- X-Real-IP by default -- read straight off the
              #     request with no trust check anywhere
              #     (validation/options.go:83 installs the parser, ip/
              #     realclientip.go:67 uses it). --trusted-proxy-ip does NOT
              #     gate this; upstream's own warning at validation/
              #     allowlist.go:22 says the same thing about X-Real-IP.
              #
              # This pod is hostNetwork, so :4180 listens on the node's LAN
              # address. "Any source" is therefore every device on the
              # customer's network, reaching oauth2-proxy without passing
              # through envoy at all -- which is also why no trusted-proxy list
              # could have fixed the log field.
              #
              # What is given up: the end-user's IP never appears in these logs
              # again. It never reliably did (envoy sends X-Forwarded-For, not
              # X-Real-IP), and the parties that actually see the client already
              # record it -- Cloudflare for the tunnel, Auth0 for the login.
              # What is gained: `client` means the peer that connected, always,
              # and no header can move it.
              #
              # Nothing here depended on the trusted headers: --redirect-url is
              # absolute, so getOAuthRedirectURI returns it before reading any
              # header (oauthproxy.go:1115), and there are no --skip-auth-route
              # patterns whose matching could be steered by X-Forwarded-Uri.
              # X-Forwarded-Email still reaches ttyd -- that header comes from
              # --pass-basic-auth / --pass-user-headers (both default true,
              # options/legacy_options.go:215) and has never been tied to this
              # flag.
              #
              # Re-enabling it means supplying --trusted-proxy-ip with this
              # cluster's pod CIDR in the same edit, and accepting that the
              # `client` field goes back to being forgeable regardless.
              # scripts/check-forwarded-header-trust.py enforces the first half.
              - --reverse-proxy=false
              - --cookie-secure=true
              - --cookie-expire=168h
            env:
              OAUTH2_PROXY_CLIENT_ID:
                valueFrom:
                  secretKeyRef:
                    name: claude-code-secret
                    key: OAUTH2_PROXY_CLIENT_ID
              OAUTH2_PROXY_CLIENT_SECRET:
                valueFrom:
                  secretKeyRef:
                    name: claude-code-secret
                    key: OAUTH2_PROXY_CLIENT_SECRET
              OAUTH2_PROXY_COOKIE_SECRET:
                valueFrom:
                  secretKeyRef:
                    name: claude-code-secret
                    key: OAUTH2_PROXY_COOKIE_SECRET
            probes:
              liveness:
                enabled: true
                custom: true
                spec:
                  tcpSocket:
                    port: 4180
                  initialDelaySeconds: 5
                  periodSeconds: 30
                  timeoutSeconds: 5
                  failureThreshold: 3
              readiness:
                enabled: true
                custom: true
                spec:
                  tcpSocket:
                    port: 4180
                  initialDelaySeconds: 5
                  periodSeconds: 30
                  timeoutSeconds: 5
                  failureThreshold: 3
            resources:
              requests:
                cpu: 10m
                memory: 32Mi
              limits:
                memory: 128Mi
#% endif %#
#% if claudecode_auth0_enabled %#
    configMaps:
      oauth2-emails:
        data:
          # One email per line, rendered at template time -- deliberately NOT
          # a Flux var: postBuild substitution collapses newlines in multi-line
          # values.
          #
          # Indexed by instance, not the global field: this ConfigMap is inside
          # the per-instance loop, and reading one global value here gave two
          # instances byte-identical allowlists. plugin.py resolves the map for
          # every instance (falling back to claudecode_allowed_emails) and fails
          # the render on a name that is not an instance, so this subscript is
          # total and a KeyError here would be a bug there.
          allowed-emails: |
#% for email in claudecode_allowed_emails_by_instance[instance].split(',') %#
            #{ email | trim }#
#% endfor %#
#% endif %#
    persistence:
#| One PVC, two mounts, and they stay together: an OAuth token and the keyring
   holding it have no reason to live on different volumes. Moving this PVC moves
   both, which is why claudecode_config_storage_class is one knob and not two.

   Its default is `db_storage_class` -- the block tier (#76, 2026-09-05
   ruling: claude's memory never lives on NFS). gnome-keyring's file locking
   and claude's small frequent writes lose the same argument against NFS that
   databases do.

   Safe only because every pre-ruling cluster migrated first (by the copy
   procedure in cluster.sample.yaml, archive taken first) and wrote its class
   into cluster.yaml: `storageClassName` is immutable, so a changed default
   migrates nothing -- on an unmigrated cluster it renders a PVC the cluster
   cannot accept, which is why #76 waited for the migration issues to close. #|
      claude-config:
        type: persistentVolumeClaim
        storageClass: #{ claudecode_config_storage_class }#
        accessMode: ReadWriteOnce
        size: 5Gi
        globalMounts:
          - path: /home/claude/.claude
          # gnome-keyring's store -- claude's OAuth tokens land here via
          # secret-service; without this mount they die with the pod.
          - path: /home/claude/.local/share/keyrings
            subPath: keyrings
#| claudecode_workspace: false removes the PVC from the release. On the NFS
   class the provisioner's archiveOnDelete renames the directory rather than
   deleting it; on local-path and longhorn-static the reclaim policy is Delete
   and nothing catches it. Hence the default is true and the sample says so in
   words -- a cluster.yaml copied from another one should not be able to destroy
   a workspace on the next `task configure` without having said so. #|
#% if claudecode_workspace %#
      claude-workspace:
        type: persistentVolumeClaim
        storageClass: #{ default_storage_class }#
        accessMode: ReadWriteOnce
        size: 20Gi
        globalMounts:
          - path: /home/claude/workspace
#% endif %#
#% if claudecode_auth0_enabled %#
      oauth2-emails:
        type: configMap
        identifier: oauth2-emails
        advancedMounts:
          #{instance}#:
            oauth2-proxy:
              - path: /etc/oauth2-proxy/allowed-emails
                subPath: allowed-emails
#% endif %#
#% if talos_mcp_config is defined %#
      talos-mcp-config:
        type: secret
        name: talos-mcp-secret
        advancedMounts:
          #{instance}#:
            talos-mcp:
              - path: /etc/talos-mcp/talosconfig
                subPath: talosconfig
                readOnly: true
#% endif %#
    defaultPodOptions:
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      securityContext:
        # root, not uid 1000 (user-confirmed 2026-07-26): the NAS NFS exports
        # only allow root -- uid 1000 saw /home/claude/coding as d---------
        # (mode 000). Root's default runtime caps also cover NET_RAW, which
        # retires the setcap-file-capability + allowPrivilegeEscalation dance
        # the scanners needed under uid 1000. HOME is pinned to /home/claude
        # via container env.
        runAsUser: 0
        runAsGroup: 0
      labels:
        hostnetwork-group: claude-code
      # hostNetwork pods all bind :7681 on the node -- hard-require spreading
      # across nodes so multiple claude_instances on the same client never
      # collide.
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchLabels:
                  hostnetwork-group: claude-code
              topologyKey: kubernetes.io/hostname
    service:
      app:
        ports:
          http:
#% if claudecode_auth0_enabled %#
            port: 4180
#% else %#
            port: 7681
#% endif %#
    route:
      app:
        hostnames: ["#{instance}#.${SECRET_DOMAIN}"]
        parentRefs:
          - name: envoy-external
            namespace: network
            sectionName: https
        rules:
          - backendRefs:
              - identifier: app
#% if claudecode_auth0_enabled %#
                port: 4180
#% else %#
                port: 7681
#% endif %#
#% endfor %#
