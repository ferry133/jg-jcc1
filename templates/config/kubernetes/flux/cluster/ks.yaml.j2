---
# Flux entry point for this per-user cluster.
# Defines the base-manifests GitRepository and all Kustomizations.
# Generated by task configure from cluster.yaml.

# ── cluster-secrets — SOPS-decrypted from per-user repo ──────────────────────
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: cluster-secrets
  namespace: flux-system
spec:
  decryption:
    provider: sops
  interval: 1h
  path: ./kubernetes/components/sops
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
---
# ── GitRepository — the shared base manifests ────────────────────────────────
#
#  `url` and `ref` come from base_repo_url / base_repo_ref / base_repo_ref_kind
#  so a cluster can follow its own fork, or pin a tag instead of tracking main.
#
#  ⚠️ The OBJECT NAME stays `jg-base` whatever the source is, and that is not
#  cosmetic. Nine Kustomizations reference it by name, and `cluster-apps-base`
#  is `prune: true` with an inventory covering cilium, cert-manager, coredns,
#  longhorn and flux-operator/flux-instance themselves. Renaming this object
#  makes Flux delete the old Kustomization, and pruning takes its inventory
#  with it — the cluster comes apart starting at the network layer. The name is
#  an internal handle, not a statement about who owns the repo.
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: jg-base
  namespace: flux-system
spec:
  interval: 1h
  # Both values QUOTED. `cue vet` guarantees these are strings in cluster.yaml,
  # but it guards the input and the retyping happens in the output: a plain YAML
  # scalar is retyped by whoever parses the rendered file, and the operators most
  # likely to set base_repo_ref are exactly the ones pinning a numeric tag.
  # Measured with yq on the rendered shape:
  #
  #     tag: 1.0        -> 1           !!float
  #     tag: 2.10       -> 2.1         !!float   <- the VALUE changed
  #     tag: 0755       -> 755         !!int
  #     tag: 20260828   -> 20260828    !!int
  #     tag: v1.0       -> "v1.0"      !!str     <- only this shape was safe
  #
  # `2.10` becoming `2.1` is the one that matters: not rejected, silently
  # reconciling a different tag. Third time this repo has been bitten by YAML
  # retyping a rendered value (jg-base#16's boolean, NODE_DNS_PATH), and the
  # first two both reached a cluster before anyone noticed.
  url: "#{ base_repo_url }#"
  ref:
    #{ base_repo_ref_kind }#: "#{ base_repo_ref }#"
---
# ── Base Kustomization — installed on every cluster ───────────────────────────
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: cluster-apps-base
  namespace: flux-system
spec:
  decryption:
    provider: sops
  deletionPolicy: WaitForTermination
  interval: 1h
  path: ./kubernetes/apps/base
  prune: true
  sourceRef:
    kind: GitRepository
    name: jg-base
    namespace: flux-system
  postBuild:
    substituteFrom:
      - name: cluster-secrets
        kind: Secret
  wait: false
  patches:
    - patch: |-
        apiVersion: kustomize.toolkit.fluxcd.io/v1
        kind: Kustomization
        metadata:
          name: _
        spec:
          decryption:
            provider: sops
          deletionPolicy: WaitForTermination
          patches:
            - patch: |-
                apiVersion: helm.toolkit.fluxcd.io/v2
                kind: HelmRelease
                metadata:
                  name: _
                spec:
                  install:
                    crds: CreateReplace
                    strategy:
                      name: RetryOnFailure
                  rollback:
                    cleanupOnFail: true
                    recreate: true
                  upgrade:
                    cleanupOnFail: true
                    crds: CreateReplace
                    strategy:
                      name: RemediateOnFailure
                    remediation:
                      remediateLastFailure: true
                      retries: 2
              target:
                group: helm.toolkit.fluxcd.io
                kind: HelmRelease
#|         The QUIC repair, when this cluster's egress blocks UDP 7844.

           It goes HERE, inside the nested patches list, and not as another
           entry in the outer `patches:` below — for the same reason the
           suspend patches further down are scalar-only. A second outer patch
           that set `spec.patches` would replace this whole nested list
           wholesale, taking the generic HelmRelease strategy with it.

           Rendered from cluster.yaml rather than pasted into the generated
           file, so it survives the next `task configure`. Before the field
           existed the fix lived in one person's clone and the next render
           removed it without saying so. #|
#% if (cloudflare_tunnel_transport | default('quic')) == 'http2' %#
            # cloudflare_tunnel_transport: http2 — this site's egress blocks UDP 7844.
            - patch: |-
                apiVersion: helm.toolkit.fluxcd.io/v2
                kind: HelmRelease
                metadata:
                  name: cloudflare-tunnel
                spec:
                  values:
                    controllers:
                      cloudflare-tunnel:
                        containers:
                          app:
                            env:
                              TUNNEL_POST_QUANTUM: false
                              TUNNEL_TRANSPORT_PROTOCOL: http2
              target:
                group: helm.toolkit.fluxcd.io
                kind: HelmRelease
                name: cloudflare-tunnel
#% endif %#
      target:
        group: kustomize.toolkit.fluxcd.io
        kind: Kustomization
#| Base apps that cannot function under this cluster's shape are suspended here.
   jg-base lists every base app unconditionally — Flux cannot decline to create a
   Kustomization from that side — so the decision has to be expressed from the
   per-user repo. This is generated from cluster.yaml rather than hand-written
   into the rendered file, so it stays visible as configuration instead of
   becoming drift.

   Scalar-only strategic merge: it sets `suspend` and nothing else, so the
   generic HelmRelease-strategy patch above survives. A second patch that set
   `spec.patches` would replace that list wholesale. #|
#% set _disabled = [] %#
#% if storage_backend != 'nfs' %#
#|   nfs-subdir provisions from a NAS this cluster does not have. #|
#% set _ = _disabled.append(('nfs-client-provisioner', 'storage_backend is ' ~ storage_backend ~ ', so there is no NAS to provision from')) %#
#% endif %#
#% if not deploy_longhorn %#
#|   Longhorn is heavier than the other provisioners and, unlike them, does not
     work at all until every node carries the iscsi-tools and util-linux-tools
     Talos extensions — which no manifest can install.

     Keyed on `deploy_longhorn`, not on storage_backend: a NAS-backed cluster
     can want Longhorn for its database while bulk stays on the NAS, and
     storage_backend cannot say that — it also decides whether nfs-subdir runs. #|
#% set _ = _disabled.append(('longhorn', 'replicated_storage is not set and storage_backend is ' ~ storage_backend ~ '; Longhorn also needs Talos system extensions on every node')) %#
#% endif %#
#% if not deploy_k8s_gateway %#
#|   k8s-gateway is the only thing that answers internal names — Cloudflare
     will not publish RFC1918 addresses (D29), so there is no public-DNS path
     to fall back from. Disable it only where the cluster has its own resolver
     serving those names. #|
#% set _ = _disabled.append(('k8s-gateway', 'this cluster declares it resolves internal names by other means')) %#
#% endif %#
#% if deployment_profile != 'appliance' %#
#|   Only an appliance is expected to land on a LAN nobody has surveyed. Every
     other profile declares its addresses in cluster.yaml, and a probe writing a
     second pool there would overlap the declared one. #|
#% set _ = _disabled.append(('lan-address-probe', 'this profile declares its LAN addresses in cluster.yaml, so there is nothing to discover')) %#
#% endif %#
#% if is_single_node %#
#|   Spegel is a peer-to-peer image mirror; with no peers its router never
     bootstraps, the pod never becomes ready, and it still rewrites every
     registry to a local port that nothing answers. #|
#% set _ = _disabled.append(('spegel', 'single-node cluster: a peer-to-peer image mirror has no peers')) %#
#% endif %#
#% for name, why in _disabled %#
    # suspended: #{ why }#
    - patch: |-
        apiVersion: kustomize.toolkit.fluxcd.io/v1
        kind: Kustomization
        metadata:
          name: #{ name }#
          namespace: flux-system
        spec:
          suspend: true
      target:
        group: kustomize.toolkit.fluxcd.io
        kind: Kustomization
        name: #{ name }#
#% endfor %#
#|   The mirror of the loop above: things jg-base ships SUSPENDED, that this
     cluster switches on.

     Two so far: longhorn-backup and claude-code-im (appended below, in that
     order). longhorn-backup applies a RecurringJob that writes to
     `longhorn_backup_target`; with no target it is not idle, it runs and fails
     nightly, and on a cluster without Longhorn it applies against a CRD no
     chart installs. So jg-base ships it off and the fact that this cluster
     declares a target is what turns it on.

     Why a suspend patch rather than jg-base selecting a directory with
     `${LONGHORN_BACKUP}`, which is what the extras' backup Kustomizations do:
     `cluster-apps` walks ./kubernetes/apps/base, so flux-local collects every
     Kustomization under it, and flux-local substitutes nothing — a `${...}` in
     a path is read literally and the whole suite dies at collection. Measured
     on ferry133/jg-base#28. The extras pattern survives only because extras
     are unreachable from apps/base and CI has never walked one. #|
#% set _enabled = [] %#
#|   longhorn-backup is emitted ALWAYS, in one of two positions -- not only when
     a target is set (ferry133/jg-base#29).

     The obvious version appends only when longhorn_backup_target is set, so
     removing the target removes the patch and jg-base's `suspend: true` comes
     back. That turns it off in git and not on the cluster: **suspend stops
     reconciliation, it does not delete what reconciliation already created.**
     The daily-backup RecurringJob stays in longhorn-system, and the one Flux
     object that would have reported it goes quiet in the same instant.

     Measured on a different app: 2026-08-19, jcom had lan-address-probe
     suspended=true with its Deployment still running 7 days later and a stray
     pool-discovered no Service used.

     So off is `path: .../backup/disabled`, an empty directory, with the
     Kustomization still reconciling. Its inventory goes empty and Flux prunes
     the RecurringJob.

     A cluster that has never re-rendered emits no patch at all and keeps
     jg-base's suspended default -- correct, because it never turned anything
     on, and an object that has never reconciled has no status.conditions for
     daily-check to trip over. #|
#% set _ = _enabled.append((
     'longhorn-backup',
     './kubernetes/apps/base/storage/longhorn/backup',
     'enabled' if (longhorn_backup_target is defined and longhorn_backup_target) else 'disabled',
     'longhorn_backup_target is set, so there is somewhere for the RecurringJob to write'
        if (longhorn_backup_target is defined and longhorn_backup_target)
        else 'no longhorn_backup_target: an empty path so Flux prunes the RecurringJob, rather than a suspend that would strand it')) %#
#|   claude-code-im: the default im.<domain> terminal, whose HelmRelease lives
     in jg-base since 2026-09-06 (this template renders extra instances only).
     Same always-emitted two-position switch as longhorn-backup, opposite
     polarity: jg-base ships it suspend:true so a user repo still rendering
     the pre-2026-09 per-user `im` never fights the base object, and THIS
     patch existing is what turns the base im on. Re-rendering is therefore
     the migration: the same commit that stops emitting the per-user im emits
     this patch.

     Keyed on claudecode_auth0_enabled because the base im hardwires the
     oauth2-proxy sidecar -- a static manifest cannot swap auth structures.
     A cluster on basic auth gets the disabled (empty) path: Flux prunes the
     base HelmRelease if it ever ran (the PVCs carry retain:true and survive),
     and the cluster's own basic-auth instance renders from claude_instances. #|
#% set _ = _enabled.append((
     'claude-code-im',
     './kubernetes/apps/base/claudecode/claude-code/im',
     'enabled' if claudecode_auth0_enabled else 'disabled',
     'the default im.<domain> web terminal from jg-base, gated on this cluster accepting the Auth0 OIDC front'
        if claudecode_auth0_enabled
        else 'claudecode_auth0 is false and the base im hardwires the Auth0 sidecar: an empty path so Flux prunes it, while the basic-auth instance renders from claude_instances')) %#
#|   claudecode-db: the explicit-memory PostgreSQL from jg-base (jgct#85), one
     per default im. Base Kustomization is named claudecode-db (NOT -postgres:
     that collides with the extras copy and would fight it on a cluster still
     running the extra -- jg-base PR#74). Always on -- every im has memory --
     so `app` is a fixed position, not a two-state switch; the patch existing
     is what unsuspends jg-base's suspend:true default.

     There is deliberately NO claudecode-db-backup entry, and its absence is
     load-bearing rather than an omission. ferry133 retired that NFS pg_dump
     CronJob on 2026-09-09 (ruling (B) on ferry133/jg-base#82): the offsite
     backup in base/monitoring/backup already dumps this same database to the
     MinIO bucket on the NAS, while the NFS copy had never once succeeded on
     jg-jiahd -- its export path was hardwired to /volume2/backup1 beside a
     templated ${NAS_SERVER}, so the mount was refused and concurrencyPolicy:
     Forbid skipped every later run.
     Dropping the entry is what removes it: jg-base ships that Kustomization
     suspend:false pointing at an empty `none` path (jg-base PR#86), so the
     patch disappearing prunes the CronJob instead of stranding it the way a
     suspend would -- which is why this change must land AFTER PR#86, not
     before. `nas_backup` and NAS_BACKUP stay: extras/default/postgres still
     selects its backup directory with ${NAS_BACKUP:=nfs}, so this is not the
     unread-key shape of jgct#90 (checked in jg-base, not assumed). The
     positions above are still chosen HERE rather than with a ${VAR} in the
     path: a base path containing one aborts flux-local collection outright
     (jg-base#28), so that constraint outlived the entry that documented it. #|
#% set _ = _enabled.append((
     'claudecode-db',
     './kubernetes/apps/base/claudecode/postgres',
     'app',
     'explicit-memory PostgreSQL from jg-base, one per default im, always on since 2026-09-06')) %#
#% for name, basepath, position, why in _enabled %#
    # #{ position | ks_position_label }#: #{ why }#
    - patch: |-
        apiVersion: kustomize.toolkit.fluxcd.io/v1
        kind: Kustomization
        metadata:
          name: #{ name }#
          namespace: flux-system
        spec:
          suspend: false
          path: #{ basepath }#/#{ position }#
      target:
        group: kustomize.toolkit.fluxcd.io
        kind: Kustomization
        name: #{ name }#
#% endfor %#
#% if is_single_node %#
#| Two envoy replicas per gateway buy nothing on one node — both land on the
   same machine, so the second is a copy that dies with the first — and they
   are the largest thing on the cluster. Measured on jgt-appliance: four envoy
   pods requesting 1056Mi each, 4.2GiB of a 7GiB node, which left the second
   replica of each gateway Pending on Insufficient memory indefinitely.

   Applied to every EnvoyProxy rather than by name, so a gateway added later
   is covered without anyone remembering this. #|
    # single node: one envoy replica per gateway, not two
    - patch: |-
        - op: add
          path: /spec/patches/-
          value:
            patch: |-
              - op: replace
                path: /spec/provider/kubernetes/envoyDeployment/replicas
                value: 1
            target:
              group: gateway.envoyproxy.io
              kind: EnvoyProxy
      target:
        group: kustomize.toolkit.fluxcd.io
        kind: Kustomization
        name: envoy-gateway
#% endif %#
#% if deployment_profile == 'appliance' %#
#| An appliance discovers its addresses, so it must never ask for a specific
   one. jg-base asks by annotation, falling back to `0.0.0.0` when the cluster
   declares none — a request LB-IPAM can never satisfy, so the service stays
   `<pending>` forever. Measured on jgt-appliance: `lan-address-probe` had
   selected and published 10.9.1.254 while k8s-gateway sat pending asking for
   0.0.0.0.

   Removing the annotation lets IPAM allocate from the probed pool.

   `remove`, not an empty value: the Gateway CRD rejects a null annotation.

   envoy-external never pins, even after `lan_shared_addr` is declared: that
   field pins the address the LAN-facing services share, and envoy-external
   cannot be one of them — it listens on the same 80/443 as envoy-internal, so
   Cilium will not let it share. It takes the pool's second address, and with
   the first one spoken for by annotation there is only one left to take. #|
    # appliance: envoy-external always allocates from the probed pool
    - patch: |-
        - op: add
          path: /spec/patches/-
          value:
            patch: |-
              - op: remove
                path: /spec/infrastructure/annotations/lbipam.cilium.io~1ips
            target:
              group: gateway.networking.k8s.io
              kind: Gateway
              name: envoy-external
      target:
        group: kustomize.toolkit.fluxcd.io
        kind: Kustomization
        name: envoy-gateway
#% endif %#
#% if deployment_profile == 'appliance' and not lan_shared_addr | default('') %#
#| The shared address, on the other hand, is only free while it is un-pinned.
   Once `lan_shared_addr` is declared the annotation carries it, which is the
   whole point of pinning (see fleet-ops docs/operations/router-dns.md) — the address is
   then an external contract with the router and must not be reselected. #|
    # appliance, shared address not yet pinned: allocate it from the pool too
    - patch: |-
        - op: add
          path: /spec/patches/-
          value:
            patch: |-
              - op: remove
                path: /spec/infrastructure/annotations/lbipam.cilium.io~1ips
            target:
              group: gateway.networking.k8s.io
              kind: Gateway
              name: envoy-internal
      target:
        group: kustomize.toolkit.fluxcd.io
        kind: Kustomization
        name: envoy-gateway
    - patch: |-
        - op: add
          path: /spec/patches/-
          value:
            patch: |-
              - op: remove
                path: /spec/values/service/annotations/lbipam.cilium.io~1ips
            target:
              group: helm.toolkit.fluxcd.io
              kind: HelmRelease
              name: k8s-gateway
      target:
        group: kustomize.toolkit.fluxcd.io
        kind: Kustomization
        name: k8s-gateway
#% endif %#
#% if cilium_native_routing | default(false) %#
#| Cilium native routing instead of the default vxlan tunnel. Needed by a
   cluster that hosts Omni: SideroLink carries WireGuard over the pod network,
   and vxlan's 1370-byte pod MTU is too small for it — the tunnel fails with
   `sendmmsg: message too long` and Omni's UI and kubectl crawl. Removing the
   encapsulation allows MTU 1500 and makes DSR usable, which vxlan does not
   support.

   JSON6902 append, not strategic merge: appending to the cilium child
   Kustomization's `spec.patches` preserves the generic HelmRelease-strategy
   patch above. A second strategic merge would replace that list wholesale —
   verified on jcom, which is where this override comes from. #|
    # native routing: this cluster hosts Omni and SideroLink needs MTU 1500
    - patch: |-
        - op: add
          path: /spec/patches/-
          value:
            patch: |-
              apiVersion: helm.toolkit.fluxcd.io/v2
              kind: HelmRelease
              metadata:
                name: cilium
              spec:
                values:
                  routingMode: native
                  ipv4NativeRoutingCIDR: "#{ cluster_pod_cidr }#"
                  autoDirectNodeRoutes: true
                  MTU: 1500
                  loadBalancer:
                    mode: "dsr"
            target:
              group: helm.toolkit.fluxcd.io
              kind: HelmRelease
              name: cilium
      target:
        group: kustomize.toolkit.fluxcd.io
        kind: Kustomization
        name: cilium
#% endif %#
---
# ── claude-code instances (base; per-cluster rendered from claude_instances) ──
# The shared pieces (namespace, SA/RBAC, OCIRepository, secrets) come from
# apps/base/claudecode in jg-base; only the per-instance HelmReleases are
# rendered here, because instance names and the optional oauth2-proxy /
# talos-mcp sidecars are template-time structure, not Flux values.
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: claude-code-instances
  namespace: flux-system
spec:
  decryption:
    provider: sops
  deletionPolicy: WaitForTermination
  interval: 1h
  path: ./kubernetes/apps/base/claudecode/claude-code/instances
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  postBuild:
    substituteFrom:
      - name: cluster-secrets
        kind: Secret
  dependsOn:
    - name: cluster-apps-base
#| Apps that graduated from extras to base. The filter skips them so a per-user
   cluster.yaml that still lists one does not render a Kustomization pointing at
   a jg-base path that no longer exists.

     claudecode/claude-code, monitoring/daily-check     2026-08-07
     storage/local-path-provisioner                     2026-08-11
     default/echo                                       2026-08-23

   local-path is not the alternative to NFS — it is the node-local tier, and a
   cluster with a NAS still needs one (Postgres on NFS is wrong on fsync and
   lock semantics regardless of NAS size). So it is installed everywhere and
   never suspended, and `storage_backend` only decides which class is default.

   echo now publishes two names off one pod — echo-ext.<domain> on
   envoy-external and echo-int.<domain> on envoy-internal — so that a cluster
   can say which of the two ingress paths is down without a second thing to
   deploy. The old single name echo.<domain> is gone.

   storage/nfs-subdir is likewise a base app, but it IS conditional, so it is
   disabled by the suspend patch on cluster-apps-base above rather than here. #|
#% set _now_base = ['claudecode/claude-code', 'monitoring/daily-check', 'storage/local-path-provisioner', 'default/echo'] %#
#% for extra in extras | default([]) if extra not in _now_base %#
#% set _app = extra.split('/')[1] %#
---
# ── extras/#{extra}# ─────────────────────────────────────────────────────────
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: extras-#{_app}#
  namespace: flux-system
spec:
  decryption:
    provider: sops
  deletionPolicy: WaitForTermination
  interval: 1h
  path: ./kubernetes/apps/extras/#{extra}#
  prune: true
  sourceRef:
    kind: GitRepository
    name: jg-base
    namespace: flux-system
  postBuild:
    substituteFrom:
      - name: cluster-secrets
        kind: Secret
  dependsOn:
    - name: cluster-apps-base
#% endfor %#
