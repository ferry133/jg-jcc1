---
apiVersion: v1
kind: Secret
metadata:
  name: cluster-secrets
  namespace: flux-system
stringData:
  CLUSTER_NAME: "#{ cluster_name }#"
  NODE_CIDR: "#{ node_cidr }#"
  NODE_DEFAULT_GATEWAY: "#{ node_default_gateway }#"
  # Whether this cluster's nodes resolve the way a LAN client does, so
  # daily-check knows whether its internal-name probe means anything here.
  # Derived from node_dns_servers, never declared: an operator-supplied "how did
  # you wire the router" is a second copy of a fact that lives in the router,
  # and the copy that drifts is the one the check believes.
  #
  # `lan` or `public`, and a word rather than a boolean on purpose
  # (ferry133/jg-base#16). Kustomize does not preserve the quotes around a bare
  # ${VAR} in the consuming manifest, so whatever Flux substitutes in is
  # re-typed by the YAML parser -- `true` came back as a YAML boolean,
  # stringData only accepts strings, and the API server rejected daily-check's
  # entire Secret. No checks ran and the dead-man ping never fired. The
  # predecessor NODE_DNS_IS_LAN is deliberately gone rather than kept in step:
  # a stale copy of it in an already-rendered cluster-secrets is simply unread.
  NODE_DNS_PATH: "#{ node_dns_path }#"
  SECRET_DOMAIN: "#{ cloudflare_domain }#"
  CLOUDFLARE_TOKEN: "#{ cloudflare_token }#"
  # Absent under the appliance profile: the LAN-facing address is discovered at
  # runtime and the rest have no consumer there. Defaulted explicitly so an
  # absent field renders as empty rather than silently via chainable-undefined.
  CLUSTER_API_ADDR: "#{ cluster_api_addr | default('') }#"
  CLUSTER_GATEWAY_ADDR: "#{ cluster_gateway_addr | default('') }#"
  CLUSTER_DNS_GATEWAY_ADDR: "#{ cluster_dns_gateway_addr | default('') }#"
  CLOUDFLARE_GATEWAY_ADDR: "#{ cloudflare_gateway_addr | default('') }#"
  COREDNS_CLUSTER_IP: "#{ coredns_cluster_ip }#"
  # LoadBalancer pool. LB_POOL_BLOCKS lists only the addresses this cluster
  # actually assigns, replacing a pool that spans the whole customer LAN.
  # The wide pool stays enabled until there is something to replace it with.
  # Set only when the LAN-facing services collapse onto one address; empty is
  # "no sharing key" to Cilium, not "a key everyone shares".
  # ClusterIP on an appliance: cloudflared reaches the external gateway by
  # in-cluster DNS name, so a LAN address there would be taken for nobody.
  ENVOY_EXTERNAL_SERVICE_TYPE: "#{ envoy_external_service_type }#"
  LAN_SHARING_KEY: "#{ lan_sharing_key }#"
  LAN_SHARING_CROSS_NAMESPACE: "#{ lan_sharing_cross_namespace }#"
  LB_POOL_BLOCKS: '#{ lb_pool_blocks }#'
  MARIADB_LB_IP: "#{ mariadb_lb_ip | default('') }#"
  OMNI_UDP_LB_IP: "#{ omni_udp_lb_ip | default('') }#"
  # Storage tiers. DEFAULT_STORAGE_CLASS is what bulk data gets;
  # DB_STORAGE_CLASS is the block tier, which is never an NFS class.
  DEFAULT_STORAGE_CLASS: "#{ default_storage_class }#"
  DB_STORAGE_CLASS: "#{ db_storage_class }#"
  LOCAL_PATH_IS_DEFAULT: "#{ local_path_is_default }#"
  # Absent unless storage_backend is nfs.
  NAS_SERVER: "#{ nas_server | default('') }#"
  NAS_PATH: "#{ nas_path | default('') }#"
  NAS_CODING_PATH: "#{ nas_coding_path | default('') }#"
  # Which backup directory the database extras render: `nfs` or `none`.
  # Derived from nas_server, never declared. Flux cannot branch on "is
  # NAS_SERVER set" -- drone/envsubst has no working `${VAR:+alt}` -- so the
  # selector has to arrive as a word. `none`, not empty or false: an empty
  # scalar is YAML null and `false` is a YAML boolean, and either gets the
  # consuming Secret rejected outright (ferry133/jg-base#16 / #17).
  NAS_BACKUP: "#{ nas_backup }#"
  # Longhorn's own off-node backup target (ferry133/jg-base#7). Empty unless
  # longhorn_backup_target is declared, and jg-base then renders
  # byte-identically to today -- measured with `helm template` against chart
  # 1.12.0, diffing the whole render.
  #
  # No companion selector, unlike NAS_BACKUP: whether the RecurringJob is
  # applied is a suspend patch in flux/cluster/ks.yaml below, because a
  # `${...}` in a Kustomization path under apps/base makes `flux-local test`
  # die at collection -- it substitutes nothing and reports "is not a
  # directory". Measured on ferry133/jg-base#28.
  #
  # The URL is quoted here and deliberately UNQUOTED where jg-base consumes it:
  # kustomize does not preserve quotes, and the chart drops a null key while
  # writing an empty string. That asymmetry is what makes an unset target a
  # no-op rather than a change.
  LONGHORN_BACKUP_TARGET: "#{ longhorn_backup_target | default('') }#"
  # Public key from .sops.yaml. Backups are encrypted to it, so the ability to
  # read them travels with age.key and not with the R2 credentials.
  BACKUP_AGE_RECIPIENT: "#{ backup_age_recipient | default('') }#"
  # Off-site backup destination (required under the appliance profile).
  BACKUP_R2_BUCKET: "#{ backup_r2_bucket | default('') }#"
  BACKUP_R2_ENDPOINT: "#{ backup_r2_endpoint | default('') }#"
  BACKUP_R2_ACCESS_KEY_ID: "#{ backup_r2_access_key_id | default('') }#"
  BACKUP_R2_SECRET_ACCESS_KEY: "#{ backup_r2_secret_access_key | default('') }#"
  # Absent unless the cluster opted out of Auth0 with claudecode_auth0: false.
  TTYD_CREDENTIAL: "#{ ttyd_credential | default('') }#"
  CLAUDECODE_AUTH0_CLIENT_ID: "#{ claudecode_auth0_client_id | default('') }#"
  CLAUDECODE_AUTH0_CLIENT_SECRET: "#{ claudecode_auth0_client_secret | default('') }#"
  CLAUDECODE_OAUTH2_COOKIE_SECRET: "#{ claudecode_oauth2_cookie_secret | default('') }#"
  # The FACTORY Auth0 tenant (jgct#84, ferry133 2026-09-06): four values from
  # the gitignored auth0.json, identical across the fleet, gating the base im --
  # the factory's support agent. The CLAUDECODE_AUTH0_* keys above are the
  # CUSTOMER tenant, for instances a cluster names in claude_instances.
  #
  # Empty here only when claudecode_auth0 is false (no OIDC at all); otherwise
  # the render fails rather than emitting a blank gate.
  #
  # jg-base#75 (PR#80, merged 2026-09-07) switched the base im to these four.
  # Both sets rendered side by side through the switch, so it had no window.
  # Nothing in jg-base reads CLAUDECODE_AUTH0_DOMAIN or CLAUDECODE_ALLOWED_EMAILS
  # for the base im any more; check-claudecode-auth.py requires the customer
  # fields only when claude_instances names an instance.
  FACTORY_AUTH0_DOMAIN: "#{ factory_auth0_domain | default('') }#"
  FACTORY_AUTH0_CLIENT_ID: "#{ factory_auth0_client_id | default('') }#"
  FACTORY_AUTH0_CLIENT_SECRET: "#{ factory_auth0_client_secret | default('') }#"
  # Comma-separated ON ONE LINE: postBuild substitution collapses newlines,
  # so the im pod's initContainer is what splits it.
  FACTORY_ALLOWED_EMAILS: "#{ factory_allowed_emails | default('') }#"
  # CLAUDECODE_AUTH0_CLIENT_ID/_CLIENT_SECRET and CLAUDECODE_OAUTH2_COOKIE_SECRET
  # (above) still reach customer extra instances through claude-code-secret's
  # OAUTH2_PROXY_* keys.
  #
  # CLAUDECODE_AUTH0_DOMAIN and CLAUDECODE_ALLOWED_EMAILS rendered here too
  # (jgct#81, 2026-09-06) while the base im read them; jg-base#75 (2026-09-07)
  # moved the im to the FACTORY_* set above and nothing read them after that,
  # so jgct#90 dropped them. Extra instances take the same two values at Jinja
  # render time from cluster.yaml (instances/helmrelease.yaml.j2: the issuer
  # flag and the allowlist ConfigMap), never through postBuild. A rendered key
  # nobody reads makes the option look supported -- jg-base's claude-code
  # README was the first to read it that way. Bringing one back means adding
  # the name to jg-base's substitution-vocabulary.txt first (a reviewed diff:
  # that guard fails both on an undeclared use and on a declared name nobody
  # uses), and only then emitting it here.
  #
  # The storage class is still read by the base im (its config PVC):
  # plugin-resolved (defaults to default_storage_class) and it must keep
  # rendering the class the existing im-claude-config PVC was created with:
  # PVC storageClassName is immutable, and a changed value fails the helm
  # upgrade on the adopted claim.
  CLAUDECODE_CONFIG_STORAGE_CLASS: "#{ claudecode_config_storage_class }#"
  # Reader-role talosconfig for the talos-mcp sidecar (insideman); b64
  # because it's multi-line YAML and Flux's ${VAR} substitution corrupts
  # multi-line values (same reason OMNI_GPG_KEY_B64 below is b64-wrapped).
  TALOS_MCP_CONFIG_B64: "#{ talos_mcp_config | default('') | b64encode }#"
  # The talosconfig above carries no key material of its own (Omni's siderov1
  # auth has no local-PGP-key fallback inside a fresh container) -- the SA's
  # actual bearer credential is this key, both are single-line already so no
  # b64 wrapping needed. Endpoint MUST be a direct (non-Cloudflare-Tunnel) gRPC
  # path -- Cloudflare Tunnel breaks gRPC trailers, which the Talos siderov1
  # proxy's streaming calls depend on (found 2026-07-30 against jg-jiahd).
  TALOS_MCP_SA_KEY: "#{ talos_mcp_sa_key | default('') }#"
  # When that key expires (YYYY-MM-DD). jg-base puts it on every workload that
  # holds the key, as an annotation daily-check row 24 reads -- the check itself
  # reads no Secrets (ferry133/fleet-ops#11). Paired with the key in plugin.py.
  TALOS_MCP_SA_KEY_EXPIRES: "#{ talos_mcp_sa_key_expires | default('') }#"
  TALOS_MCP_OMNI_ENDPOINT: "#{ talos_mcp_omni_endpoint | default('') }#"
  # factory's provisioning credentials -- consumed by
  # jg-base `extras/factory/factory/app/credentials-secret.yaml`, which reads
  # them as `${FACTORY_*}` postBuild substitutions with `:-` defaults.
  #
  # Only the cluster hosting factory sets these (jcom). Everywhere else they
  # render empty, and empty is the correct shipped state -- it means "not
  # issued yet" and every consumer says so rather than degrading into looking
  # like it worked.
  #
  # ⚠️ Until 2026-08-27 these five lines did not exist, so the consuming half
  # in jg-base had nothing to consume: factory's pod ran 2/2 Ready with all
  # three credentials at length zero. The Deployment listed the env names, the
  # Secret existed, and `kubectl get pods` said Running -- **the only thing
  # that distinguished it from working was measuring the values themselves.**
  #
  # OMNI endpoint MUST be a direct (non-Cloudflare-Tunnel) gRPC path, same
  # reason as TALOS_MCP_OMNI_ENDPOINT above. The default lives in jg-base
  # (`http://omni.omni.svc.cluster.local:8080`), so leaving this empty is
  # correct rather than incomplete.
  #
  # FOUR, not five. FACTORY_CLOUDFLARE_TOKEN was here from 2026-08-27 until
  # 2026-08-29 and is gone with its consumer (ferry133/jg-base#46): factory
  # holds no Cloudflare credential, because under D11 each customer's account
  # is the customer's own and one scalar field cannot carry one token per
  # customer. Emitting it here after jg-base dropped the Secret key would put a
  # value into cluster-secrets that nothing reads — configured-looking and
  # inert, which is the exact failure that section of jg-base's README exists
  # to describe.
  FACTORY_OMNI_SA_KEY: "#{ factory_omni_sa_key | default('') }#"
  # Its expiry -- a date, not a fifth credential (same as TALOS_MCP_SA_KEY_EXPIRES).
  FACTORY_OMNI_SA_KEY_EXPIRES: "#{ factory_omni_sa_key_expires | default('') }#"
  FACTORY_OMNI_ENDPOINT: "#{ factory_omni_endpoint | default('') }#"
  FACTORY_GITHUB_TOKEN: "#{ factory_github_token | default('') }#"
  # Its expiry, for jg-base daily-check row 25 (ferry133/jg-base#99). Paired
  # with the token in plugin.py, like the two keys above.
  FACTORY_GITHUB_TOKEN_EXPIRES: "#{ factory_github_token_expires | default('') }#"
  # b64-wrapped: it is a multi-line PEM and Flux's ${VAR} substitution corrupts
  # multi-line values (same reason as TALOS_MCP_CONFIG_B64 above).
  FACTORY_FLEET_OPS_DEPLOY_KEY_B64: "#{ factory_fleet_ops_deploy_key | default('') | b64encode }#"
#| A private repo cannot be fetched over anonymous HTTPS, and the deploy key this
   repo already renders is an SSH credential -- so the scheme has to change with
   the visibility, not just the secret. `#56` measured the half-state: the
   `github-deploy-key` Secret rendered while nothing referenced it and the URL
   stayed HTTPS, so `repository_visibility: "private"` read as supported and
   produced `GitRepository READY=False` on jg-janncotcc.

   FLUX_SYNC_PULL_SECRET is empty on a public cluster ON PURPOSE and is read by
   check-private-repo-chain.py, not by any manifest yet -- see that script for
   why the steady-state half cannot land here. #|
#% if repository_visibility == 'private' %#
  FLUX_SYNC_URL: "ssh://git@github.com/#{ repository_name }#.git"
  FLUX_SYNC_PULL_SECRET: "github-deploy-key"
#% else %#
  FLUX_SYNC_URL: "https://github.com/#{ repository_name }#.git"
  FLUX_SYNC_PULL_SECRET: ""
#% endif %#
  CLOUDFLARE_TUNNEL_TOKEN: "#{ cloudflare_tunnel_secret() }#"
  CLOUDFLARE_TUNNEL_ID: "#{ cloudflare_tunnel_id() }#"
  GITHUB_WEBHOOK_TOKEN: "#{ github_webhook_token | default('') }#"
  POSTGRES_PASSWORD: "#{ postgres_password | default('') }#"
  TRELLO_API_KEY: "#{ trello_api_key | default('') }#"
  TRELLO_API_TOKEN: "#{ trello_api_token | default('') }#"
  TRELLO_BOARD_ID: "#{ trello_board_id | default('') }#"
  LINE_CHANNEL_ACCESS_TOKEN: "#{ line_channel_access_token | default('') }#"
  LINE_CHANNEL_SECRET: "#{ line_channel_secret | default('') }#"
  LINE_NOTIFY_GROUP_ID: "#{ line_notify_group_id | default('') }#"
  ANTHROPIC_API_KEY: "#{ anthropic_api_key | default('') }#"
  DATABASE_URL: "#{ database_url | default('') }#"
  SYNOPHOTO_AUTH0_DOMAIN: "#{ synophoto_auth0_domain | default('') }#"
  SYNOPHOTO_AUTH0_CLIENT_ID: "#{ synophoto_auth0_client_id | default('') }#"
  SYNOPHOTO_AUTH0_CLIENT_SECRET: "#{ synophoto_auth0_client_secret | default('') }#"
  SYNOPHOTO_ALLOWED_EMAILS: "#{ synophoto_allowed_emails | default('') }#"
  SYNOPHOTO_FLASK_SECRET_KEY: "#{ synophoto_flask_secret_key | default('') }#"
  SYNOPHOTO_NAS_USERNAME: "#{ synophoto_nas_username | default('') }#"
  SYNOPHOTO_NAS_PASSWORD: "#{ synophoto_nas_password | default('') }#"
  FREEPBX_MYSQL_ROOT_PASSWORD: "#{ freepbx_mysql_root_password | default('') }#"
  FREEPBX_MYSQL_PASSWORD: "#{ freepbx_mysql_password | default('') }#"
  CLAUDECODE_POSTGRES_PASSWORD: "#{ claudecode_postgres_password | default('') }#"
  CLAUDE_CODE_DATABASE_URL: "#{ claude_code_database_url | default('') }#"
  OMNI_GPG_KEY_B64: "#{ omni_gpg_key | default('') | b64encode }#"
  MQTT_LB_IP: "#{ mqtt_lb_ip | default('') }#"
  INGRESS_NGINX_LB_IP: "#{ ingress_nginx_lb_ip | default('') }#"
  CLOUDFLARE_LAN_TUNNEL_TOKEN: "#{ cloudflare_lan_tunnel_token | default('') }#"
  DAILY_CHECK_SMTP_HOST: "#{ daily_check_smtp_host | default('smtp.gmail.com') }#"
  DAILY_CHECK_SMTP_PORT: "#{ daily_check_smtp_port | default('587') }#"
  DAILY_CHECK_SMTP_USERNAME: "#{ daily_check_smtp_username | default('') }#"
  DAILY_CHECK_SMTP_PASSWORD: "#{ daily_check_smtp_password | default('') }#"
  DAILY_CHECK_SMTP_FROM: "#{ daily_check_smtp_from | default('') }#"
  DAILY_CHECK_NOTIFY_EMAIL_TO: "#{ daily_check_notify_email_to | default('') }#"
  DAILY_CHECK_HEALTHCHECKS_PING_URL: "#{ daily_check_healthchecks_ping_url | default('') }#"
  DAILY_CHECK_ENDPOINTS: "#{ daily_check_endpoints | default('') }#"
